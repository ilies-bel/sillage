{
  "name": "sillage",
  "version": "0.1.4",
  "private": true,
  "main": "dist-electron/electron/app/main.js",
  "description": "Desktop meeting notetaker for ESN sales reps: transcribes the machine's own audio, writes French notes, and pushes to VerySwing after one confirmation.",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "build": "npm run clean && tsc && vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:electron:tsc": "tsc -p electron/tsconfig.json",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "postinstall": "patch-package && node scripts/rebuild-native-electron.js && node scripts/patch-electron-plist.js && node scripts/verify-native-arch.js",
    "rebuild:native": "node scripts/rebuild-native-electron.js && node scripts/verify-native-arch.js",
    "prepare": "husky",
    "electron:dev": "npm run build && npm run build:electron && cross-env NODE_ENV=development electron .",
    "record": "npm run build:electron && cross-env SILLAGE_DEV_RECORD=1 electron .",
    "electron:build": "npm run build:electron && cross-env NODE_ENV=production electron .",
    "preapp:dev": "node scripts/prune-logs.mjs",
    "app:dev": "concurrently --kill-others --kill-signal SIGKILL \"npm run dev -- --port 5180 --strictPort\" \"wait-on http://localhost:5180 && npm run electron:dev\"",
    "app:build": "node scripts/package-app.mjs",
    "app:build:signed": "node scripts/package-app.mjs --signed",
    "watch": "tsc -p electron/tsconfig.json --watch",
    "start": "npm run app:dev",
    "dist": "npm run app:build",
    "dist:signed": "npm run app:build:signed",
    "build:native": "node scripts/build-native.js",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "npm run build && npm run build:electron && node scripts/e2e.mjs",
    "test:ci": "npm run check && npm test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:crm": "node scripts/check-crm-containment.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:ports": "node scripts/check-ports.mjs",
    "check:surfaces": "node scripts/check-surfaces.mjs",
    "check:reasons": "node scripts/check-reasons.mjs",
    "check": "npm run typecheck:electron && npm run typecheck:renderer && npm run check:boundaries && npm run check:crm && npm run check:tokens && npm run check:platform && npm run check:french && npm run check:ports && npm run check:surfaces && npm run check:reasons",
    "whisper:fetch": "node scripts/fetch-whisper-model.mjs",
    "replay": "npm run build:electron && node scripts/replay.mjs",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "replay:extract": "node --experimental-strip-types scripts/replay-extraction.mjs",
    "seed:vsa": "node --experimental-strip-types scripts/seed-vsa.mjs",
    "check:platform": "node scripts/check-platform.mjs",
    "check:french": "node scripts/check-french.mjs"
  },
  "build": {
    "appId": "fr.ilies-bel.sillage",
    "afterPack": "./scripts/ad-hoc-sign.js",
    "productName": "Sillage",
    "copyright": "Copyright © 2026 Iliès Beldjilali",
    "files": [
      "dist",
      "dist-electron",
      "native-module",
      "package.json",
      "node_modules",
      "!**/native-module/target",
      "!**/native-module/src",
      "!**/native-module/.cargo",
      "!**/*.map",
      "!**/.env",
      "!**/.env.*",
      "!**/*.log",
      "!**/*.pdf",
      "!**/.git"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib",
      "**/*.dll",
      "**/whisper/worker.js",
      "**/node_modules/keytar/**",
      "**/node_modules/@napi-rs/**",
      "**/node_modules/@huggingface/transformers/**",
      "**/node_modules/@huggingface/jinja/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/detect-libc/**",
      "**/node_modules/semver/**",
      "**/node_modules/onnxruntime-common/**",
      "**/node_modules/onnxruntime-node/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "resources/whisper-models/",
        "to": "whisper-models/"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/mac/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Sillage a besoin de l'autorisation d'enregistrement de l'ecran pour capter l'audio systeme de la reunion.",
        "NSMicrophoneUsageDescription": "Sillage a besoin du micro pour transcrire votre voix pendant la reunion.",
        "NSAudioCaptureUsageDescription": "Sillage a besoin de l'audio systeme pour transcrire la reunion."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/png/",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ilies-bel",
        "repo": "sillage"
      }
    ],
    "npmRebuild": false,
    "beforePack": "./scripts/rebuild-native-for-target.cjs"
  },
  "keywords": [
    "electron",
    "desktop",
    "meeting-notes",
    "notetaker",
    "transcription",
    "whisper",
    "speech-to-text",
    "crm",
    "veryswing",
    "esn",
    "french"
  ],
  "author": {
    "name": "Iliès Beldjilali",
    "email": "ilies.beldjilali@shodo-studio.io",
    "url": "https://github.com/ilies-bel"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/ilies-bel/sillage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilies-bel/sillage.git"
  },
  "bugs": {
    "url": "https://github.com/ilies-bel/sillage/issues"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@napi-rs/cli": "^3.5.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/color": "^4.2.0",
    "@types/diff": "^6.0.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.12.3",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "electron": "43.1.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.49",
    "react-doctor": "^0.2.10",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@azure/msal-node": "^5.5.0",
    "@huggingface/transformers": "^3.8.1",
    "@types/keytar": "^4.4.0",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.7.3",
    "form-data": "^4.0.6",
    "framer-motion": "^12.29.2",
    "keytar": "^7.9.0",
    "lucide-react": "^0.460.0",
    "markdown-it": "^14.3.0",
    "onnxruntime-common": "1.22.0",
    "onnxruntime-node": "1.22.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.0",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@vectorize-io/hindsight-client": "^0.8.2",
    "sqlite-vec-darwin-arm64": "^0.1.7-alpha.2",
    "sqlite-vec-darwin-x64": "^0.1.7-alpha.2"
  },
  "overrides": {
    "onnxruntime-node": "1.22.0",
    "react-reconciler": {
      "react": "$react"
    }
  }
}

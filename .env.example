# Copy to `.env` and fill in what you need. **Nothing here is required.**
#
# Since DEC-34 the supported way to give this app a provider key is
# *Réglages → Transcription / Modèle de langage*, which writes it to the OS
# credential store. This file is a **development override**: it exists so
# `SILLAGE_OPENAI_API_KEY=… npm start` works without clicking through a
# settings screen, and so CI needs no keychain. A key stored in Réglages wins
# over the same key here.
#
# Read by electron/app/devEnv.ts, in development only — the real environment
# always wins over the file, and a packaged build never reads it at all.
#
# Every name is `SILLAGE_*`. This file previously listed OPENAI_API_KEY,
# GEMINI_API_KEY, GRAPH_CLIENT_ID and VSA_API_KEY — names from the retired
# product that nothing reads. If a variable is not in this list, adding it to
# `.env` does nothing.

# ── LLM (interpretation only — never deterministic data, DEC-7) ──────────────
# Hosted rows, usable on the key alone:
SILLAGE_MISTRAL_API_KEY=
SILLAGE_MISTRAL_MODEL=mistral-large-latest

SILLAGE_AZURE_OPENAI_ENDPOINT=
SILLAGE_AZURE_OPENAI_DEPLOYMENT=
SILLAGE_AZURE_OPENAI_API_KEY=

# Self-hosted / local. Both are required; the model is never guessed, because a
# wrong default 404s at the first extraction and reads like an outage.
#
# Since DEC-34 these are also fields in *Réglages → Modèle de langage → Modèle
# local → Configurer*, which is the supported way — and what is typed there wins
# over what is here.
SILLAGE_LLM_LOCAL_URL=
SILLAGE_LLM_LOCAL_MODEL=
SILLAGE_LLM_LOCAL_API_KEY=

# ChatGPT subscription (DEC-36). **Nothing to put here.** The grant `codex login`
# left in ~/.codex/auth.json is what configures this row, and the model name
# comes from ~/.codex/config.toml. These two exist only to point the app at a
# different Codex installation — a fixture, a second account — and the third to
# override the model when the endpoint refuses the one Codex is set to.
SILLAGE_CODEX_AUTH_PATH=
SILLAGE_CODEX_CONFIG_PATH=
SILLAGE_CHATGPT_MODEL=

# More of the same. Every hosted row says « hors machine » in Réglages and
# nothing refuses it for that (DEC-33). Where a client's transcript may be
# processed is a contractual decision the app does not make and no longer
# claims to know (DEC-37); when two rows are otherwise equal, table order picks.
SILLAGE_OPENAI_API_KEY=
SILLAGE_OPENAI_MODEL=
SILLAGE_GROQ_API_KEY=
SILLAGE_GROQ_MODEL=

# ── Speech-to-text ───────────────────────────────────────────────────────────
# Local Whisper is the DEFAULT, not a fallback (DEC-30) and needs no key. These
# are the opt-in cloud accuracy upgrade, and `SILLAGE_STT_PREFER_CLOUD=1` is
# what opts in. Each row says whether it runs here; none is refused for it.
SILLAGE_AZURE_SPEECH_KEY=
SILLAGE_AZURE_SPEECH_REGION=francecentral
SILLAGE_DEEPGRAM_API_KEY=
SILLAGE_ELEVENLABS_API_KEY=

# The one switch that still refuses a provider outright: the rep asked for
# nothing to leave the machine, so only local engines are eligible (HR-4).
SILLAGE_STT_OFFLINE_ONLY=
SILLAGE_STT_PREFER_CLOUD=
SILLAGE_WHISPER_MODEL=

# ── Microsoft Entra (HR-3: calendar + mail drafts. Mail.ReadWrite only, never
#    Mail.Send — HR-8) ─────────────────────────────────────────────────────────
SILLAGE_ENTRA_CLIENT_ID=
SILLAGE_ENTRA_AUTHORITY=
SILLAGE_ENTRA_REDIRECT_PORT=

# ── VerySwing (DEC-28: the public sandbox, not a client tenant) ──────────────
SILLAGE_VSA_BASE_URL=
SILLAGE_VSA_LOGIN=
SILLAGE_VSA_PASSWORD=
SILLAGE_VSA_AUTH_TYPE=
SILLAGE_VSA_ENTITY_ID=
SILLAGE_VSA_ENTITY_CODE=
SILLAGE_VSA_ACTION_USER_ID=
SILLAGE_VSA_SALES_LOGIN=
SILLAGE_VSA_SALES_USER_IDS=
SILLAGE_VSA_OWN_DOMAINS=
